<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
  <View android:id="@+id/sheetScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#52000000" />
  <ScrollView android:id="@+id/sheetContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_nfc_bottom_sheet" android:elevation="18dp" android:importantForAccessibility="yes" android:visibility="invisible">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="14dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
      <View android:layout_width="52dp" android:layout_height="5dp" android:background="@drawable/bg_nfc_sheet_handle" android:importantForAccessibility="no" />
      <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="sans-serif-medium" android:textColor="#111827" android:textSize="20sp" />
      <TextView android:id="@+id/tvGuide" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:accessibilityLiveRegion="polite" android:fontFamily="sans-serif" android:textColor="#6B7280" android:textSize="14sp" />
      <ImageView android:id="@+id/ivNfcHint" android:layout_width="112dp" android:layout_height="112dp" android:layout_marginTop="22dp" android:src="@drawable/ic_nfc_scan_hint" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
        <TextView android:id="@+id/tvProgressPercent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="sans-serif-medium" android:gravity="end" android:text="0%" android:textColor="#111827" android:textSize="14sp" />
        <ProgressBar android:id="@+id/nfcProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/bg_nfc_progress_bar" />
      </LinearLayout>
      <Button android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:background="@drawable/bg_nfc_cancel_button" android:backgroundTint="@null" android:elevation="0dp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="#111827" android:textSize="16sp" />
      <Button android:id="@+id/btnRetry" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_nfc_retry_button" android:backgroundTint="@null" android:elevation="0dp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="#007AFF" android:textSize="16sp" android:visibility="gone" />
      <Button android:id="@+id/btnOpenNfcSettings" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_nfc_retry_button" android:backgroundTint="@null" android:elevation="0dp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="#007AFF" android:textSize="16sp" android:visibility="gone" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
