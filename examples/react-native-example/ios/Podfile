# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'NitroNfcExample' do
  # Keep local monorepo development source-based. Published npm packages do not
  # set this flag and instead link their bundled XCFrameworks.
  use_source_core = ENV.fetch('NITRO_NFC_USE_SOURCE_CORE', '1') != '0'
  ENV['NITRO_NFC_USE_SOURCE_CORE'] = '1' if use_source_core
  use_manual_openssl =
    ENV['NITRO_NFC_USE_MANUAL_OPENSSL'] == '1' ||
    ENV['NFCSDK_USE_MANUAL_OPENSSL'] == '1'

  # The example simulates a host app that already owns OpenSSL. A real host
  # can replace this pod with its compatible existing provider.
  pod 'OpenSSL-Universal', '~> 1.1' if use_manual_openssl
  pod 'NFCCore', :path => '../../../native/ios/NFCCore' if use_source_core
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
