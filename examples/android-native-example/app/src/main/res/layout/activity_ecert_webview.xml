<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/ecertWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/closeEcertButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/ecert_close"
        android:text="@string/ecert_close" />

    <TextView
        android:id="@+id/bridgeUnavailableMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CCB00020"
        android:padding="16dp"
        android:text="@string/ecert_bridge_unavailable"
        android:textColor="@android:color/white"
        android:visibility="gone" />
</FrameLayout>
