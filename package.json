{
  "name": "nfc-sdk-monorepo",
  "private": true,
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-nitro-nfc-example",
    "prepare": "yarn workspace react-native-nitro-nfc prepare",
    "nitrogen": "yarn workspace react-native-nitro-nfc nitrogen",
    "typecheck": "yarn workspace react-native-nitro-nfc typecheck",
    "lint": "yarn workspace react-native-nitro-nfc lint",
    "test": "yarn workspace react-native-nitro-nfc test",
    "build:android": "turbo run build:android --filter=react-native-nitro-nfc",
    "build:ios": "turbo run build:ios --filter=react-native-nitro-nfc",
    "flutter:bundle-native": "bash packages-flutter/scripts/bundle-native-artifacts.sh",
    "flutter:verify-native-bundles": "node packages-flutter/scripts/verify-native-bundles.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  }
}
